NODE_ENV=development
# The unauthenticated fake/demo adapters are local-only. Keep this on loopback.
LOCAL_BIND_ADDRESS=127.0.0.1
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://slopproof:slopproof@localhost:5432/slopproof
SESSION_SECRET=replace-with-at-least-32-random-characters
GITHUB_ADAPTER=fake
GITHUB_APP_ID=fake-local
GITHUB_PRIVATE_KEY=fake-local-never-used
GITHUB_WEBHOOK_SECRET=local-webhook-secret-at-least-32-characters
GITHUB_CLIENT_ID=fake-local
GITHUB_CLIENT_SECRET=fake-local
EVIDENCE_STORAGE_PROVIDER=s3
S3_CONTROL_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=slopproof-evidence
S3_ACCESS_KEY_ID=slopproof
S3_SECRET_ACCESS_KEY=replace-local-storage-secret
KEY_WRAPPING_PROVIDER=local
KEY_WRAPPING_PUBLIC_KEY_PATH=infra/docker/secrets/wrapping-public.pem
KEY_WRAPPING_PRIVATE_KEY_PATH=infra/docker/secrets/wrapping-private.pem
TRANSCRIPTION_PROVIDER=fake
MULTIMODAL_JUDGE_PROVIDER=fake
PROVIDER_API_KEY=fake-local-never-used
LOG_LEVEL=info
WORKER_INTERNAL_URL=http://localhost:4001
WORKER_INTERNAL_SECRET=replace-with-at-least-32-random-characters
WORKER_HOST=127.0.0.1
# Local-only example; replace with `openssl rand -base64 32` outside demo mode.
PROVIDER_PAYLOAD_KEY_BASE64=cHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHA=
DEMO_MODE=true
DEMO_FAKE_MEDIA=false
