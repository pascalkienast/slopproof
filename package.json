{
  "name": "slopproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @slopproof/web --filter @slopproof/worker --filter @slopproof/github-control dev",
    "dev:web": "pnpm --filter @slopproof/web dev",
    "dev:worker": "pnpm --filter @slopproof/worker dev",
    "dev:keys": "node scripts/generate-dev-keys.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "production:env": "tsx scripts/compile-production-env.ts",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:live-smoke-contracts": "node --test scripts/lib/live-smoke.test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "audit:boundaries": "node scripts/audit-boundaries.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:live-smoke-contracts && pnpm build && pnpm audit:boundaries && pnpm audit:secrets",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "@playwright/test": "1.62.1",
    "@slopproof/auth": "workspace:*",
    "@slopproof/analysis": "workspace:*",
    "@slopproof/config": "workspace:*",
    "@slopproof/db": "workspace:*",
    "@slopproof/github": "workspace:*",
    "@slopproof/policy": "workspace:*",
    "@slopproof/questions": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "testcontainers": "12.1.0",
    "tsx": "4.23.12",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
