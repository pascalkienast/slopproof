# Copy values into an operator-owned secret store. Do not source this file as-is.
NODE_ENV=production
DEPLOYMENT_PROFILE=production
APP_BASE_URL=https://slopproof.example.com
DATABASE_URL=postgres://slopproof:replace-with-a-random-password@postgres:5432/slopproof
SESSION_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
DEMO_MODE=false
DEMO_FAKE_MEDIA=false

GITHUB_ADAPTER=octokit
GITHUB_APP_ID=replace-with-numeric-app-id
GITHUB_PRIVATE_KEY_PATH=/operator/secrets/github-app.pem
GITHUB_PRIVATE_KEY_CONTAINER_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

GENERATION_PROVIDER=hetzner
GENERATION_BASE_URL=https://inference.example.com/v1
GENERATION_API_KEY=replace-with-generation-provider-key
LEARNING_MODEL=replace-with-learning-model
PRACTICE_MODEL=replace-with-practice-model
PROOF_QUESTION_MODEL=replace-with-proof-question-model

MULTIMODAL_JUDGE_PROVIDER=hetzner
JUDGE_BASE_URL=https://inference.example.com/v1
JUDGE_API_KEY=replace-with-judge-provider-key
JUDGE_MODEL=replace-with-judge-model
JUDGE_FALLBACK_MODEL=replace-with-fallback-model

TRANSCRIPTION_PROVIDER=openrouter
TRANSCRIPTION_BASE_URL=https://transcription.example.com/v1
TRANSCRIPTION_API_KEY=replace-with-transcription-provider-key
TRANSCRIPTION_MODEL=replace-with-transcription-model

EVIDENCE_STORAGE_PROVIDER=s3
S3_CONTROL_ENDPOINT=https://objects.example.com
S3_PUBLIC_ENDPOINT=https://uploads.example.com
S3_REGION=eu-central-1
S3_BUCKET=slopproof-evidence
S3_ACCESS_KEY_ID=replace-with-bucket-scoped-access-id
S3_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret

KEY_WRAPPING_PROVIDER=local
KEY_WRAPPING_PUBLIC_KEY_PATH=/operator/secrets/wrapping-public.pem
KEY_WRAPPING_PRIVATE_KEY_PATH=/operator/secrets/wrapping-private.pem
KEY_WRAPPING_PUBLIC_KEY_CONTAINER_PATH=/run/secrets/wrapping-public.pem
KEY_WRAPPING_PRIVATE_KEY_CONTAINER_PATH=/run/secrets/wrapping-private.pem

WORKER_INTERNAL_URL=http://worker:4001
WORKER_INTERNAL_SECRET=replace-with-at-least-32-random-characters
PROVIDER_PAYLOAD_KEY_BASE64=replace-with-canonical-base64-for-32-random-bytes
WORKER_HOST=0.0.0.0
WORKER_PORT=4001
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
