# Import this site block from the host Caddy configuration only after the
# production Compose readiness check succeeds. Gate 9 owns the live backup,
# validation, reload and rollback. SLOPPROOF_SITE and LANDING_ROOT are
# non-secret render-time values. The proxy authenticator remains a runtime
# file placeholder backed by a systemd credential; it must never be expanded
# while adapting this Caddyfile to the admin API's JSON configuration.
{$SLOPPROOF_SITE} {
	log {
		format filter {
			# App paths and headers can contain revision/attempt identifiers,
			# capabilities, CSRF tokens and OAuth state. Drop the complete maps
			# instead of trying to maintain an incomplete sensitive-field list.
			request>uri delete
			request>remote_ip delete
			request>client_ip delete
			request>headers delete
			resp_headers delete
		}
	}

	header {
		>Strict-Transport-Security "max-age=31536000; includeSubDomains"
		>X-Content-Type-Options "nosniff"
		>X-Frame-Options "DENY"
		>Referrer-Policy "no-referrer"
	}

	@mobile path /m /m/*
	header @mobile >Permissions-Policy "camera=(self), microphone=(self), geolocation=()"

	@non_mobile {
		not path /m /m/*
	}
	header @non_mobile >Permissions-Policy "camera=(), microphone=(), geolocation=()"

	@landing {
		method GET HEAD
		path /
	}
	@landing_script {
		method GET HEAD
		path /landing.js
	}
	@landing_product_flow {
		method GET HEAD
		path /product-flow/*
	}
	root * {$LANDING_ROOT}
	header @landing >Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; connect-src 'self' https://bf2f734c49e05a3ed1cbad16f0049e6c.eu.r2.cloudflarestorage.com; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
	header @landing_script >Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	header @landing_product_flow >Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	header @landing_product_flow >Cache-Control "public, max-age=86400"
	handle @landing_script {
		file_server
	}
	handle @landing_product_flow {
		file_server
	}
	handle @landing {
		try_files /index.html
		file_server
	}

	@app path /api /api/* /_next /_next/* /revisions /revisions/* /m /m/* /review /review/* /icon.svg
	handle @app {
		reverse_proxy 127.0.0.1:3000 {
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			# header_up set replaces every client-supplied value. Do not pair
			# these fields with a delete operation: Caddy applies the delete
			# independently and would remove the trusted replacement too.
			header_up X-SlopProof-Client-IP {http.request.remote.host}
			header_up X-SlopProof-Proxy-Authenticator {file./run/credentials/caddy.service/oauth-proxy-authenticator}
		}
	}

	handle {
		respond "Not found" 404
	}
}
